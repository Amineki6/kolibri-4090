# Model weights & checkpoints (~45 GiB)
checkpoints/
*.safetensors
*.pt
*.bin

# Compiled CUDA extension artifacts (rebuilt automatically by kolibri_kernels.py)
csrc/build/
*.so
*.o
build/
*.egg-info/

# Scratch & temporary benchmark files (~15 MiB)
scratch/
results/tmp_*.json
*.tmp
*.log

# Dev-only & internal profiling scripts
scripts/phase1_*.py
scripts/bench_step3_*.py
scripts/bench_hybrid.py

# Benchmark & verification outputs (track only the 6 clean bench_suite progression reports)
results/*
!results/baseline.json
!results/omp_pcore.json
!results/omp_mempool.json
!results/omp_mempool_cacheops.json
!results/omp_mempool_cacheops_graphb.json
!results/omp_mempool_cacheops_graphab.json

# Nsight Systems traces & exports
traces/
*.nsys-rep
*.sqlite
*.qdrep
*.qdstrm

# Python / IDE / local environment
__pycache__/
*.py[cod]
